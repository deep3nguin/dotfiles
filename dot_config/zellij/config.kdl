// Zellij configuration file (DeepMind Theme & Minimalist UI)

keybinds {
    normal {
        // Custom shortcuts
    }
}

// Set custom palette matching DESIGN.md
theme "qn37x"

themes {
    qn37x {
        fg "#e2e2e2"      // On-surface
        bg "#0C1614"      // Surface Dark
        black "#121414"   // Surface
        red "#ffb4ab"     // Error
        green "#00FF8A"   // Growth Green
        yellow "#00BFD6"  // Action Cyan
        blue "#00FF8A"    // Growth Green
        magenta "#00BFD6" // Action Cyan
        cyan "#00BFD6"    // Action Cyan
        white "#e2e2e2"   // On-surface
        orange "#ffdad6"  // On-error-container / Peach
    }
}

// Use the minimalist compact layout (compact status bar)
default_layout "compact"

// UI simplifications
pane_frames false
simplified_ui true

// Settings
copy_on_select true
mouse_mode true
scroll_buffer_size 10000
