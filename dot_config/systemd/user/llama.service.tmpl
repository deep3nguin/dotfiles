[Unit]
Description=Llama.cpp local AI inference server (on-demand loading)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/llama-server --model {{ .chezmoi.homeDir }}/.local/share/models/llama-3.2-3b-instruct.gguf --port 8080 --ctx-size 4096 --n-gpu-layers 99
Restart=on-failure

[Install]
WantedBy=default.target
